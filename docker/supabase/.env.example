# BabyApp local Supabase stack — environment template.
#
# You normally never touch this file: `scripts/setup-docker.sh` copies it to
# `docker/supabase/.env` and fills in fresh random secrets (and generates the
# ANON_KEY / SERVICE_ROLE_KEY JWTs that match the random JWT_SECRET).
#
# If you create `.env` manually: change every secret, and generate
# ANON_KEY / SERVICE_ROLE_KEY yourself — they must be HS256 JWTs signed with
# your JWT_SECRET (see scripts/setup-docker.sh for the exact one-liner).
#
# Pinned stack: supabase/supabase tag v1.26.08.

############
# Secrets
############

# Postgres (any long random string)
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# HS256 signing secret for all JWTs (>= 32 chars).
# ANON_KEY / SERVICE_ROLE_KEY below must be signed with this value.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Legacy API keys (HS256-signed JWTs, roles "anon" and "service_role").
# The values below are the Supabase demo keys matching the demo JWT_SECRET —
# regenerate both whenever you change JWT_SECRET.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Dashboard (Supabase Studio) basic-auth credentials
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# Realtime + Supavisor encryption keys
#   SECRET_KEY_BASE:  >= 64 chars  (openssl rand -base64 48)
#   VAULT_ENC_KEY:    exactly 32   (openssl rand -hex 16)
#   PG_META_CRYPTO_KEY: >= 32      (openssl rand -base64 24)
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
VAULT_ENC_KEY=your-32-character-encryption-key
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

# S3-protocol endpoint credentials for Storage (openssl rand -hex 16 / 32)
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907

# Opaque API keys (new-style auth keys; optional for a local stack — the
# legacy ANON_KEY / SERVICE_ROLE_KEY above are what everything uses).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

############
# URLs
############

# Public base URL of the API gateway (kong). The BabyApp client is built
# against this URL (VITE_SUPABASE_URL in the root .env).
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
# Where the app lives (auth "site URL"; redirect base for OAuth/email links)
SITE_URL=http://localhost:8088
ADDITIONAL_REDIRECT_URLS=

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
# Host port for Postgres (via the Supavisor pooler, session mode)
POSTGRES_PORT=5432

############
# Supavisor (pooler)
############

# Host port for transaction-mode pooling
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=babyapp-local
POOLER_DB_POOL_SIZE=5

############
# Studio (dashboard)
############

STUDIO_DEFAULT_ORGANIZATION=BabyApp
STUDIO_DEFAULT_PROJECT=BabyApp
# Optional: enables the AI assistant inside Studio.
OPENAI_API_KEY=

############
# Auth (gotrue)
############

JWT_EXPIRY=3600
DISABLE_SIGNUP=false

# Email auth — no SMTP server is included in this stack, so auto-confirm is
# on and the SMTP block is inert (gotrue logs mail it cannot send).
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true

############
# Storage
############

# File backend (data lives in volumes/storage/)
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=stub

############
# Edge functions
############

# JWT verification for ALL functions. Keep false locally: the BabyApp calls
# Barry with the anon key and the function trusts it (like the hosted demo).
FUNCTIONS_VERIFY_JWT=false

# Barry (the BabyApp assistant). Any OpenAI-compatible endpoint works
# (OpenAI, Groq, Together, Ollama, LM Studio, vLLM, llama.cpp). Without
# BARRY_BASE_URL and BARRY_API_KEY, Barry answers with a "configure me" 503.
# Local servers (llama.cpp, Ollama, LM Studio) ignore the key — any non-empty
# placeholder works. If the server has no /embeddings endpoint, leave
# BARRY_EMBEDDING_MODEL empty and Barry uses keyword search.
#   e.g. BARRY_BASE_URL=http://10.55.1.18:8081/v1
#        BARRY_API_KEY=local
#        BARRY_MODEL=Ornith-1.5-9B-Q6_K
BARRY_BASE_URL=
BARRY_API_KEY=
BARRY_MODEL=gpt-4o-mini
BARRY_EMBEDDING_MODEL=

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# API gateway (kong)
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# imgproxy
############

IMGPROXY_AUTO_WEBP=true
